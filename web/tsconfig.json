{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "react-native-keyboard-controller": [
        "./src/shims/keyboard-controller.tsx"
      ],
      "expo-image-picker": [
        "./src/shims/image-picker.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-demo",
    "e2e"
  ]
}
