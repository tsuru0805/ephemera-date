{
  "name": "ephemera-date-web",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node scripts/copy-canvaskit.mjs && expo start --web",
    "build": "node scripts/copy-canvaskit.mjs && expo export -p web --output-dir dist && node scripts/postbuild.mjs dist",
    "build:demo": "node scripts/copy-canvaskit.mjs && EXPO_PUBLIC_DEMO_BUILD=1 EPHEMERA_WEB_BASE=${EPHEMERA_WEB_BASE:-/ephemera-date} expo export -p web --output-dir dist-demo && node scripts/postbuild.mjs dist-demo --demo",
    "fonts": "python3 scripts/subset_fonts.py",
    "test": "jest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "7.3.3",
    "@shopify/react-native-skia": "2.2.12",
    "canvaskit-wasm": "0.40.0",
    "expo": "54.0.35",
    "expo-asset": "12.0.13",
    "expo-constants": "18.0.13",
    "expo-font": "14.0.12",
    "expo-linear-gradient": "15.0.8",
    "expo-linking": "8.0.12",
    "expo-router": "6.0.24",
    "expo-status-bar": "3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-reanimated": "4.1.7",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.1.17",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "^54.0.12",
    "fake-indexeddb": "6.2.6",
    "jest": "29.7.0",
    "jest-expo": "54.0.17",
    "react-test-renderer": "19.1.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/src/**/*.test.tsx"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/e2e/"
    ],
    "moduleNameMapper": {
      "^react-native-keyboard-controller$": "<rootDir>/src/shims/keyboard-controller.tsx",
      "^expo-image-picker$": "<rootDir>/src/shims/image-picker.ts"
    },
    "testTimeout": 30000,
    "modulePaths": [
      "<rootDir>/node_modules"
    ]
  }
}
